# Copy to .env (git-ignored) and fill in. Load before a run:
#   set -a; . ~/work/vera/vera-tuning/.env; set +a
# DeepSeek, the teacher: every hole answer comes from it (tools/vera-harness/agent-run.js).
ARKESTR_API_KEY=
# Jev (TypeSafe): reads whether a section does each need; without it sections are accepted unread.
TYPESAFE_API_KEY=
# Exa web search, optional: without it requests that need real web data are declined.
EXA_API_KEY=
